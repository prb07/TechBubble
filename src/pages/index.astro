---
import NewsLayout from "../components/NewsLayout.astro";
import TrendingBar from "../components/TrendingBar.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="TechBubble"
  description="TechBubble - Latest technology news, AI, startups, cybersecurity and innovation."
  bodyClass="home-page"
>
  <TrendingBar />

  <main>
    <section class="news-section" aria-label="Latest technology news">
      <NewsLayout />
    </section>
  </main>
</SiteLayout>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }

  body {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    color: var(--reader-text, #21184f);
    font-family:
      Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  main {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .news-section {
    width: min(1240px, calc(100% - 40px));
    margin: 26px auto 64px;
  }

  html[data-reading-mode="soft"] body.home-page {
    --site-background:
      radial-gradient(
        circle at 15% 55%,
        rgba(255, 185, 210, 0.35),
        transparent 30%
      ),
      radial-gradient(
        circle at 85% 45%,
        rgba(190, 170, 255, 0.35),
        transparent 32%
      ),
      linear-gradient(135deg, #fffaf8 0%, #ffffff 45%, #faf5ff 100%);
  }

  @media (max-width: 900px) {
    .news-section {
      width: calc(100% - 32px);
      margin: 22px auto 48px;
    }
  }
</style>
