---
import Background from "../components/Background.astro";
import AppBar from "../components/AppBar.astro";
import TrendingBar from "../components/TrendingBar.astro";
import HeroText from "../components/HeroText.astro"
import FeaturedArticle from "../components/FeaturedArticle.astro";
---

<html>

<head>
<meta charset="UTF-8">
<title>TechPulse</title>
</head>

<body>

<Background />
<AppBar />
<TrendingBar/>
<div class="hero-layout">

<HeroText />

<FeaturedArticle />

</div>
<style>

.hero-layout{

max-width:1320px;

margin:0 auto;

display:grid;

grid-template-columns:1fr 1fr;

gap:60px;

padding:0 30px;

align-items:start;

}


@media(max-width:900px){

.hero-layout{

grid-template-columns:1fr;

}

}

</style>


</body>

</html>