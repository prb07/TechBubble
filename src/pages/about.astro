---
import ComingSoon from "../components/ComingSoon.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="About | TechBubble"
  description="The TechBubble About page is coming soon."
  bodyClass="coming-soon-page"
  skipHref="#coming-soon-content"
  skipLabel="Skip to page content"
>
  <ComingSoon section="About" />
</SiteLayout>

<style is:global>
  * {
    box-sizing: border-box;
  }

  body.coming-soon-page {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
    background: var(--site-background, var(--reader-page, #faf7ff));
  }
</style>
