---
import AppBar from "../components/AppBar.astro";
import Background from "../components/Background.astro";
import "../styles/reading-modes.css";

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  lang?: string;
  skipHref?: string;
  skipLabel?: string;
}

const {
  title,
  description,
  bodyClass,
  lang = "en",
  skipHref,
  skipLabel = "Skip to content",
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-reading-mode="soft">

<head>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta name="description" content={description} />

  <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />

  <title>{title}</title>


  <!-- Google Analytics -->

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>

  <script is:inline>
    window.dataLayer = window.dataLayer || [];

    function gtag(){
      dataLayer.push(arguments);
    }

    gtag('js', new Date());

    gtag('config', 'G-1M4CM5RS8K');
  </script>


  <!-- Restore the tiny local preference before paint to avoid a theme flash -->

  <script is:inline>
    (() => {
      const allowedModes = ["soft", "paper", "night"];

      try {
        const savedMode = localStorage.getItem("techbubble-reading-mode");

        if (savedMode && allowedModes.includes(savedMode)) {
          document.documentElement.dataset.readingMode = savedMode;
        }
      } catch {
        // Storage can be unavailable in privacy-focused browsers.
      }
    })();
  </script>


  <slot name="head" />

</head>


<body class={bodyClass}>

  {skipHref && <a class="skip-link" href={skipHref}>{skipLabel}</a>}

  <Background />

  <AppBar />

  <slot />

</body>


</html>