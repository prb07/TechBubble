---
import { defineQuery } from "groq";
import type { SanityImageSource } from "@sanity/image-url";
import { sanityClient, urlFor } from "../lib/sanity";

interface FlashFeedArticle {
  _id: string;
  title: string;
  slug: string;
  author?: string;
  readTime?: string;
  image: SanityImageSource & {
    alt?: string;
  };
}

const FLASH_FEED_QUERY = defineQuery(/* groq */ `
  *[
    _type == "article" &&
    defined(title) &&
    defined(slug.current) &&
    defined(image.asset)
  ] | order(_createdAt desc)[0...8] {
    _id,
    title,
    "slug": slug.current,
    author,
    readTime,
    image {
      asset,
      alt,
      hotspot,
      crop
    }
  }
`);

let articles: FlashFeedArticle[] = [];

try {
  articles = await sanityClient.fetch<FlashFeedArticle[]>(FLASH_FEED_QUERY);
} catch (error) {
  console.error("Unable to load Sanity articles for FlashFeed", error);
}

const slides = articles.map((article) => ({
  ...article,
  imageUrl: urlFor(article.image)
    .width(1080)
    .height(720)
    .fit("crop")
    .auto("format")
    .url(),
}));
---


<section
  class="flashfeed"
  data-flash-feed
  aria-label="Latest FlashFeed stories"
  aria-roledescription="carousel"
  aria-live="off"
>
  {slides.length > 1 && (
    <button
      class="rotation-toggle"
      type="button"
      data-flash-feed-toggle
      aria-label="Pause FlashFeed"
      aria-pressed="false"
    >
      Pause
    </button>
  )}

  {slides.length > 0 ? (
    slides.map((article, index) => (
      <article
        class:list={["flashfeed-slide", { "is-active": index === 0 }]}
        data-flash-feed-slide
        aria-hidden={index === 0 ? "false" : "true"}
      >
        <a
          class="slide-link"
          href={`/article/${encodeURIComponent(article.slug)}/`}
          aria-label={`Read article: ${article.title}`}
          data-flash-feed-link
          tabindex={index === 0 ? undefined : -1}
        >
          <img
            src={article.imageUrl}
            alt={article.image.alt || article.title}
            width="1080"
            height="720"
            loading={index < 2 ? "eager" : "lazy"}
            decoding={index === 0 ? "sync" : "async"}
            fetchpriority={index === 0 ? "high" : "auto"}
          />

          <div class="overlay" aria-hidden="true"></div>

          <div class="content">
            <span class="category">FLASH FEED</span>
            <h2>{article.title}</h2>

            {(article.author || article.readTime) && (
              <p class="meta">
                {article.author || "TechBubble"}
                {article.readTime && <span aria-hidden="true"> | </span>}
                {article.readTime}
              </p>
            )}
          </div>
        </a>
      </article>
    ))
  ) : (
    <div class="empty-state">
      <span class="category">FLASH FEED</span>
      <h2>New stories are being prepared.</h2>
      <p>Check back soon for the latest TechBubble news.</p>
    </div>
  )}
</section>

<script>
  const ROTATION_INTERVAL_MS = 6500;
  const ANIMATION_CLEANUP_MS = 680;

  function initialiseFlashFeed(feed: HTMLElement) {
    if (feed.dataset.initialised === "true") return;
    feed.dataset.initialised = "true";

    const slides = Array.from(
      feed.querySelectorAll<HTMLElement>("[data-flash-feed-slide]"),
    );
    const rotationToggle = feed.querySelector<HTMLButtonElement>(
      "[data-flash-feed-toggle]",
    );

    if (slides.length < 2 || !rotationToggle) return;

    let activeIndex = 0;
    let intervalId: number | undefined;
    let transitionIndex = 0;
    let isPaused = false;
    const animationCleanupIds = new Set<number>();

    const prepareSlideImage = (slide: HTMLElement | undefined) => {
      const image = slide?.querySelector<HTMLImageElement>("img");

      if (!image) return;

      image.loading = "eager";
      void image.decode().catch(() => undefined);
    };

    const showSlide = (nextIndex: number) => {
      const currentSlide = slides[activeIndex];
      const nextSlide = slides[nextIndex];

      if (!currentSlide || !nextSlide || nextIndex === activeIndex) return;

      const entersFromLeft = transitionIndex % 2 === 0;
      const enterClass = entersFromLeft ? "enter-from-left" : "enter-from-top";
      const leaveClass = entersFromLeft ? "leave-to-right" : "leave-to-bottom";
      const currentLink = currentSlide.querySelector<HTMLAnchorElement>(
        "[data-flash-feed-link]",
      );
      const nextLink = nextSlide.querySelector<HTMLAnchorElement>(
        "[data-flash-feed-link]",
      );

      transitionIndex += 1;

      nextSlide.classList.remove(
        "is-active",
        "is-leaving",
        "is-preparing",
        "enter-from-left",
        "enter-from-top",
        "leave-to-right",
        "leave-to-bottom",
      );
      nextSlide.classList.add(enterClass, "is-preparing");
      nextSlide.setAttribute("aria-hidden", "false");

      void nextSlide.offsetWidth;

      currentSlide.classList.add("is-leaving", leaveClass);
      currentSlide.classList.remove("is-active");
      currentSlide.setAttribute("aria-hidden", "true");
      currentLink?.setAttribute("tabindex", "-1");
      nextLink?.removeAttribute("tabindex");

      activeIndex = nextIndex;
      void prepareSlideImage(slides[(activeIndex + 1) % slides.length]);

      window.requestAnimationFrame(() => {
        nextSlide.classList.remove("is-preparing");
        nextSlide.classList.add("is-active");
      });

      const cleanupId = window.setTimeout(() => {
        currentSlide.classList.remove("is-leaving", leaveClass);
        nextSlide.classList.remove(enterClass);
        animationCleanupIds.delete(cleanupId);
      }, ANIMATION_CLEANUP_MS);

      animationCleanupIds.add(cleanupId);
    };

    const stopRotation = () => {
      if (intervalId === undefined) return;
      window.clearInterval(intervalId);
      intervalId = undefined;
    };

    const startRotation = () => {
      stopRotation();
      if (document.hidden || isPaused) return;

      intervalId = window.setInterval(() => {
        showSlide((activeIndex + 1) % slides.length);
      }, ROTATION_INTERVAL_MS);
    };

    const handleVisibilityChange = () => {
      if (document.hidden) {
        stopRotation();
      } else {
        startRotation();
      }
    };

    const updateRotationToggle = () => {
      rotationToggle.textContent = isPaused ? "Play" : "Pause";
      rotationToggle.setAttribute("aria-pressed", String(isPaused));
      rotationToggle.setAttribute(
        "aria-label",
        isPaused ? "Play FlashFeed" : "Pause FlashFeed",
      );
    };

    const toggleRotation = () => {
      isPaused = !isPaused;
      updateRotationToggle();

      if (isPaused) {
        stopRotation();
      } else {
        startRotation();
      }
    };

    const cleanup = () => {
      stopRotation();
      animationCleanupIds.forEach((cleanupId) => {
        window.clearTimeout(cleanupId);
      });
      animationCleanupIds.clear();
      document.removeEventListener("visibilitychange", handleVisibilityChange);
    };

    rotationToggle.addEventListener("click", toggleRotation);
    document.addEventListener("visibilitychange", handleVisibilityChange);
    document.addEventListener("astro:before-swap", cleanup, { once: true });

    updateRotationToggle();
    prepareSlideImage(slides[1]);
    startRotation();
  }

  function initialiseFlashFeeds() {
    document
      .querySelectorAll<HTMLElement>("[data-flash-feed]")
      .forEach(initialiseFlashFeed);
  }

  initialiseFlashFeeds();
  document.addEventListener("astro:page-load", initialiseFlashFeeds);
</script>



<style>
  .flashfeed {
    position: relative;
    isolation: isolate;
    height: 430px;
    overflow: hidden;
    border: 1px solid var(--reader-border, rgba(109, 74, 255, 0.16));
    border-radius: 18px;
    background: linear-gradient(135deg, #292044, #725cff);
    box-shadow: var(--reader-shadow, 0 20px 54px rgba(44, 31, 91, 0.12));
  }

  .rotation-toggle {
    position: absolute;
    z-index: 3;
    top: 16px;
    right: 16px;
    padding: 7px 11px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    background: rgba(20, 16, 40, 0.58);
    color: #fff;
    font: inherit;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    backdrop-filter: blur(10px);
  }

  .rotation-toggle:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }

  .slide-link {
    position: absolute;
    inset: 0;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .slide-link:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -7px;
  }

  .flashfeed-slide {
    --enter-x: 0%;
    --enter-y: 0%;
    --leave-x: 0%;
    --leave-y: 0%;

    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(var(--enter-x), var(--enter-y), 0) scale(1.008);
    transition:
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 320ms ease-out;
    backface-visibility: hidden;
  }

  .flashfeed-slide.enter-from-left {
    --enter-x: -1.5%;
  }

  .flashfeed-slide.enter-from-top {
    --enter-y: -1.5%;
  }

  .flashfeed-slide.leave-to-right {
    --leave-x: 1%;
  }

  .flashfeed-slide.leave-to-bottom {
    --leave-y: 1%;
  }

  .flashfeed-slide.enter-from-left,
  .flashfeed-slide.enter-from-top,
  .flashfeed-slide.is-leaving {
    will-change: transform, opacity;
  }

  .flashfeed-slide.is-active {
    z-index: 2;
    opacity: 1;
    pointer-events: auto;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .flashfeed-slide.is-leaving {
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(var(--leave-x), var(--leave-y), 0) scale(0.99);
  }

  .flashfeed-slide img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1.035);
    transition: transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .flashfeed-slide.is-active img {
    transform: scale(1);
  }

  .flashfeed-slide.is-leaving img {
    transform: scale(1.02);
  }

  .flashfeed-slide.is-preparing,
  .flashfeed-slide.is-preparing img,
  .flashfeed-slide.is-preparing .content {
    transition: none;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 35%, rgba(0, 0, 0, 0.86));
  }

  .content {
    position: absolute;
    right: 25px;
    bottom: 25px;
    left: 25px;
    color: #fff;
    opacity: 0;
    transform: translate3d(0, 12px, 0);
    transition:
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1) 60ms,
      opacity 300ms ease-out 60ms;
  }

  .flashfeed-slide.is-active .content {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .flashfeed-slide.is-leaving .content {
    opacity: 0;
    transform: translate3d(0, -10px, 0);
    transition-delay: 0ms;
  }

  .category {
    display: inline-block;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.45);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  h2 {
    margin: 15px 0;
    color: #fff;
    font-size: 28px;
    line-height: 1.25;
  }

  .meta {
    margin: 0;
    color: #ddd;
    font-size: 14px;
  }

  .empty-state {
    height: 100%;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #fff;
  }

  .empty-state h2 {
    margin-bottom: 8px;
  }

  .empty-state p {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .flashfeed-slide,
    .flashfeed-slide img,
    .content {
      transition: none;
    }

    .flashfeed-slide {
      transform: none;
      will-change: auto;
    }
  }

  @media (max-width: 700px) {
    .flashfeed {
      height: 350px;
    }

    .content {
      right: 18px;
      bottom: 18px;
      left: 18px;
    }

    h2 {
      font-size: 21px;
    }

    .empty-state {
      padding: 24px;
    }
  }
</style>
