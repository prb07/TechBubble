---
import FlashFeed from "./FlashFeed.astro";
import TrendingNow from "./TrendingNow.astro";
import AdBanner from "./AdBanner.astro";
---

<section class="news-layout">
  <a
    class="middle-ad"
    href="/start-a-project"
    aria-label="Start a project with TechBubble"
  >
    <span class="ad-brand">
      <span class="ad-monogram" aria-hidden="true">TB</span>
      <span class="ad-brand-copy">
        <strong>TechBubble</strong>
        <small>CREATIVE STUDIO</small>
      </span>
    </span>

    <span class="ad-copy">
      <strong>Build smarter. Launch faster.</strong>
    </span>

    <span class="ad-cta">
      Start a project <span aria-hidden="true">&rarr;</span>
    </span>
  </a>

  <div class="left">
    <TrendingNow />
  </div>

  <div class="middle">
    <p class="column-title">Featured story</p>
    <FlashFeed />
  </div>

  <div class="right">
    <AdBanner />
  </div>
</section>

<style>
  .news-layout {
    width: 100%;
    margin: 0;
    display: grid;
    grid-template-columns: 270px minmax(0, 1fr) 270px;
    grid-template-areas:
      "promo promo promo"
      "left middle right";
    align-items: start;
    gap: 18px 24px;
  }

  .left,
  .middle,
  .right {
    min-width: 0;
  }

  .left {
    grid-area: left;
  }

  .middle {
    grid-area: middle;
  }

  .right {
    grid-area: right;
  }

  .column-title {
    margin: 0 0 13px;
    color: var(--reader-text, #21184f);
    font-size: 20px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .middle-ad {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 56px;
    padding: 8px 12px;
    display: grid;
    grid-area: promo;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    overflow: hidden;
    border: 1px solid var(--reader-border, rgba(109, 74, 255, 0.18));
    border-radius: 14px;
    background: var(
      --promo-background,
      linear-gradient(100deg, #f1eaff 0%, #faf8ff 50%, #e8fbff 100%)
    );
    box-shadow: var(--promo-shadow, 0 10px 30px rgba(67, 47, 145, 0.08));
    color: var(--reader-text, #21184f);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .middle-ad::before {
    position: absolute;
    z-index: -1;
    top: -124px;
    right: 20%;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: var(--promo-orb, rgba(114, 92, 255, 0.12));
    content: "";
    filter: blur(3px);
  }

  .middle-ad:hover {
    border-color: color-mix(
      in srgb,
      var(--reader-accent, #725cff) 42%,
      transparent
    );
    transform: translateY(-1px);
  }

  .middle-ad:focus-visible {
    outline: 3px solid var(--reader-accent, #725cff);
    outline-offset: 3px;
  }

  .ad-brand {
    padding-right: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-right: 1px solid var(--reader-border, rgba(109, 74, 255, 0.18));
    white-space: nowrap;
  }

  .ad-monogram {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: linear-gradient(135deg, #725cff, #bc6cff);
    box-shadow: 0 5px 12px rgba(109, 74, 255, 0.25);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: -0.3px;
  }

  .ad-brand-copy strong,
  .ad-brand-copy small {
    display: block;
  }

  .ad-brand-copy strong {
    font-size: 12px;
    line-height: 1;
  }

  .ad-brand-copy small {
    margin-top: 4px;
    color: var(--reader-muted, #77758a);
    font-size: 6px;
    font-weight: 750;
    letter-spacing: 1.1px;
  }

  .ad-copy {
    min-width: 0;
  }

  .ad-copy strong {
    display: block;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ad-cta {
    padding: 8px 11px;
    border-radius: 9px;
    background: var(
      --reader-accent-strong,
      var(--reader-accent, #725cff)
    );
    color: #fff;
    font-size: 9px;
    font-weight: 750;
    white-space: nowrap;
  }

  @media (max-width: 1100px) {
    .news-layout {
      grid-template-columns: 240px minmax(0, 1fr) 240px;
      gap: 18px;
    }
  }

  @media (max-width: 900px) {
    .news-layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "promo"
        "middle"
        "left"
        "right";
      gap: 24px;
    }

    .right {
      padding-top: 8px;
    }
  }

  @media (max-width: 560px) {
    .middle-ad {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px;
    }

    .ad-brand {
      display: none;
    }

    .ad-copy strong {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .middle-ad {
      transition: none;
    }
  }
</style>
